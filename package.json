{
  "name": "@abhishek944/pi-ask",
  "version": "0.2.0",
  "description": "A lightweight one-shot ask command for Pi with a limited tool set.",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "ask",
    "read-only"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./guard": {
      "types": "./src/guard.ts",
      "import": "./src/guard.ts",
      "default": "./src/guard.ts"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "src",
    "prompts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "prompts": [
      "./prompts/ask.md"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abhishek944/pi-ask.git"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "check:package": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.3"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "typescript": "^5.9.3"
  }
}
